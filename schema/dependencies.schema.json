{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cn-curriculum/schema/dependencies.schema.json",
  "title": "微主题前置依赖（prerequisite edges）",
  "type": "object",
  "required": ["scope", "edgeCount", "dependencies"],
  "properties": {
    "scope": { "type": "string", "description": "覆盖范围，应与 topics 文件对应" },
    "edgeCount": { "type": "integer", "minimum": 0 },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topicId", "prerequisiteId", "strength"],
        "properties": {
          "topicId": { "type": "string", "pattern": "^cnmt_", "description": "依赖方（想学这个）" },
          "prerequisiteId": { "type": "string", "pattern": "^cnmt_", "description": "被依赖方（必须先掌握）" },
          "strength": { "type": "string", "enum": ["hard", "soft"] },
          "reason": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
